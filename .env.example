# Use your computer's LAN address when running on a physical phone.
# Android Emulator automatically falls back to http://10.0.2.2:4001/api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4001/api/v1
# Backward-compatible fallback until every backend returns key_id with Razorpay orders.
# This is a public checkout key; keep RAZORPAY_KEY_SECRET on the backend only.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
