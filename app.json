{
  "expo": {
    "name": "Udhari",
    "slug": "udhari",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/ios/iTunesArtwork@2x.png",
    "scheme": "udhariapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/ios/iTunesArtwork@2x.png",
      "bundleIdentifier": "com.udhari.app"
    },
    "android": {
      "icon": "./assets/android/playstore-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.udhari.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF4FF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0944ce0a-7e1e-414f-a918-3f56239264cf"
      }
    }
  }
}
